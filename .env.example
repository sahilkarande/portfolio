# Copy to .env and fill in. Never commit .env.

# "development" locally, "production" on PythonAnywhere
FLASK_ENV_NAME=development
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# --- Database -------------------------------------------------------------
# Leave all of these empty to use a local SQLite file (instance/portfolio.db).
# PythonAnywhere MySQL (Databases tab):
# MYSQL_HOST=yourusername.mysql.pythonanywhere-services.com
# MYSQL_USER=yourusername
# MYSQL_PASSWORD=your-db-password
# MYSQL_DB=yourusername$portfolio
# ...or give a full SQLAlchemy URL instead:
# DATABASE_URL=

# --- Mail (Gmail app password: https://myaccount.google.com/apppasswords) --
EMAIL_ADDRESS=
EMAIL_PASSWORD=
OWNER_EMAIL=
# Public address — used in emails, sitemap.xml, canonical links and social previews.
SITE_URL=https://yourusername.pythonanywhere.com

# --- Analytics (first-party, no cookies) -----------------------------------
# ANALYTICS_ENABLED=1
# ANALYTICS_RETENTION_DAYS=395
